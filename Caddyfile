# Orbit Focus - automatic HTTPS via Let's Encrypt.
# DOMAIN can be overridden from the environment: DOMAIN=focus.example.com caddy run
{$DOMAIN:orbit-focus.us.ci} {
	reverse_proxy 127.0.0.1:3000

	header {
		# X-XSS-Protection is obsolete: modern browsers ignore it, and the
		# legacy filter it enabled could itself introduce vulnerabilities.
		-Server
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	encode gzip zstd

	log {
		output file /var/log/caddy/access.log
	}
}
