# Server Configuration
PORT=3000

# Database selection for the self-hosted Express server.
# sqlite   - single file database (default), see SQLITE_PATH
# postgres - PostgreSQL via DATABASE_URL (or PG* environment variables)
DB_CLIENT=sqlite

# Path of the SQLite database file (DB_CLIENT=sqlite).
# Relative paths are resolved against the working directory.
SQLITE_PATH=data/orbit-focus.db

# PostgreSQL connection string (DB_CLIENT=postgres), e.g.
# postgres://user:password@localhost:5432/orbit_focus
DATABASE_URL=

# JWT signing secret (required when NODE_ENV=production).
# Generate with: openssl rand -hex 32
JWT_SECRET=

# GitHub OAuth App (https://github.com/settings/developers).
# Callback URL must be: <public origin>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: fixed public origin for OAuth redirects,
# e.g. http://localhost:5173 during local development.
PUBLIC_ORIGIN=

# Cloudflare Workers local development uses .dev.vars with the
# same JWT_SECRET / GITHUB_CLIENT_ID / GITHUB_CLIENT_SECRET keys.
