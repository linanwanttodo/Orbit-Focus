# Orbit Focus private Docker deployment
# Copy this file to .env before starting Docker Compose.

PORT=3000
NODE_ENV=production

# Default private deployment database: SQLite
DB_CLIENT=sqlite
SQLITE_PATH=/app/data/orbit-focus.db

# Optional PostgreSQL alternative:
# DB_CLIENT=postgres
# DATABASE_URL=postgres://user:password@postgres-host:5432/orbit_focus

# Required in production. Generate with: openssl rand -hex 32
JWT_SECRET=

# Optional GitHub login. Leave blank for anonymous-only mode.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Public HTTPS origin used for OAuth redirects, for example:
# PUBLIC_ORIGIN=https://focus.example.com
PUBLIC_ORIGIN=
