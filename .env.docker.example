# Orbit Focus private Docker deployment
# Copy this file to .env before starting Docker Compose.
#
# Every variable below is read by the Node server in server/src/index.ts.

PORT=3000
NODE_ENV=production

# Default private deployment database: SQLite
DB_CLIENT=sqlite
SQLITE_PATH=/app/data/orbit-focus.db

# Optional PostgreSQL alternative:
# DB_CLIENT=postgres
# DATABASE_URL=postgres://user:password@postgres-host:5432/orbit_focus

# Required in production. Generate with: openssl rand -hex 32
# Changing this later invalidates every existing login session.
JWT_SECRET=

# Optional GitHub login. Leave blank to hide the GitHub option in the sign-in
# dialog; QQ email accounts work without any OAuth configuration.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Public HTTPS origin used for OAuth redirects and post-login redirects, for
# example: https://focus.example.com
PUBLIC_ORIGIN=
