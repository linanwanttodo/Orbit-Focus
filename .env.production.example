# Orbit Focus production environment (Docker + Caddy deployment).
# Copy to .env.production on the server and fill in the secrets.
# .env.production is gitignored; this template is the committed copy.

NODE_ENV=production
PORT=3000

DB_CLIENT=sqlite
SQLITE_PATH=/app/data/orbit-focus.db

# Optional PostgreSQL alternative:
# DB_CLIENT=postgres
# DATABASE_URL=postgres://user:password@postgres-host:5432/orbit_focus

# Required. The server refuses to start with NODE_ENV=production when unset.
# Generate with: openssl rand -hex 32
# Changing this later invalidates every existing login session.
JWT_SECRET=

# Public HTTPS origin, used for OAuth redirects and post-login redirects.
PUBLIC_ORIGIN=https://focus.example.com

# Optional GitHub login. Leave blank to disable the GitHub sign-in option.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
